<Window x:Class="PomoTime.UI.Views.NotificationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="320" Height="110" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" ShowActivated="False">
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
            CornerRadius="12" Padding="18">
        <StackPanel><TextBlock x:Name="TitleText" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="16"/>
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
    </Border>
</Window>
