<UserControl x:Class="PomoTime.UI.Controls.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16"><TextBlock Text="Settings" FontSize="23" FontWeight="Bold"/>
            <Button Content="&#x00D7;" HorizontalAlignment="Right" FontSize="20" Padding="9,2" Click="Close_Click"/></Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabelStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                    <Button Content="Dark" Click="DarkTheme_Click"/><Button Content="Light" Margin="8,0" Click="LightTheme_Click"/>
                    <Button Content="Apply custom RGB" Click="CustomTheme_Click"/>
                </StackPanel>
                <TextBlock Text="Red"/><Slider x:Name="RedSlider" Maximum="255" Value="255"/>
                <TextBlock Text="Green"/><Slider x:Name="GreenSlider" Maximum="255" Value="105"/>
                <TextBlock Text="Blue"/><Slider x:Name="BlueSlider" Maximum="255" Value="120"/>

                <TextBlock Text="FOCUS &amp; BREAKS" Style="{StaticResource SectionLabelStyle}" Margin="0,24,0,8"/>
                <CheckBox x:Name="AutoBreakCheck" Content="Start a break automatically after completed focus sessions" Click="SettingChanged"/>
                <StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBlock Text="Break length" VerticalAlignment="Center"/>
                    <TextBox x:Name="BreakMinutesInput" Width="48" Margin="10,0" Padding="6" LostFocus="BreakMinutes_LostFocus"/><TextBlock Text="minutes" VerticalAlignment="Center"/></StackPanel>
                <CheckBox x:Name="NotificationsCheck" Content="Show completion notifications" Margin="0,10,0,0" Click="SettingChanged"/>

                <TextBlock Text="ALARM" Style="{StaticResource SectionLabelStyle}" Margin="0,24,0,8"/>
                <Button Content="Import alarm into database" HorizontalAlignment="Left" Click="ImportAlarm_Click"/>
                <TextBlock x:Name="AlarmName" Text="Default system chime" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/>

                <TextBlock Text="TAGS" Style="{StaticResource SectionLabelStyle}" Margin="0,24,0,8"/>
                <StackPanel Orientation="Horizontal"><TextBox x:Name="NewTagInput" Width="180" Padding="7"/><Button Content="Add" Margin="8,0" Click="AddTag_Click"/>
                    <Button Content="Remove" Click="RemoveTag_Click"/></StackPanel>
                <ListBox x:Name="TagsList" Height="82" Margin="0,8,0,0" Background="{DynamicResource ControlBrush}" Foreground="{DynamicResource TextBrush}"/>

                <TextBlock Text="AMBIENT PLAYLIST" Style="{StaticResource SectionLabelStyle}" Margin="0,24,0,8"/>
                <StackPanel Orientation="Horizontal"><Button Content="Import songs" Click="ImportSongs_Click"/>
                    <Button Content="Play" Margin="8,0" Click="PlaySong_Click"/><Button Content="Stop" Click="StopSong_Click"/>
                    <Button Content="Remove" Margin="8,0,0,0" Click="RemoveSong_Click"/></StackPanel>
                <ListBox x:Name="Playlist" Height="100" Margin="0,8,0,0" Background="{DynamicResource ControlBrush}" Foreground="{DynamicResource TextBrush}"/>

                <TextBlock Text="DATA" Style="{StaticResource SectionLabelStyle}" Margin="0,24,0,8"/>
                <Button Content="Export session history" HorizontalAlignment="Left" Click="Export_Click"/>
                <TextBlock Text="Exports timestamps, duration, completion state, and tags as CSV or JSON."
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,18" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
