<Window x:Class="PomoTime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PomoTime"
        Title="PomoTime" Width="900" Height="650" MinWidth="820" MinHeight="600"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Grid Margin="36,28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PomoTime" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Make this moment count." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <local:TimerRing x:Name="Clock" Width="350" Height="350" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Focus for" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="MinutesInput" Text="25" Width="48" Margin="10,0" Padding="7" TextAlignment="Center"
                             Background="#30343F" Foreground="White" BorderThickness="0" LostFocus="MinutesInput_LostFocus"/>
                    <TextBlock Text="minutes" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0"/>
                    <Button x:Name="StartPauseButton" Content="Start" Background="{StaticResource AccentBrush}" Click="StartPause_Click"/>
                    <Button Content="Reset" Margin="10,0,0,0" Click="Reset_Click"/>
                </StackPanel>
            </Grid>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22">
                <StackPanel>
                    <TextBlock Text="YOUR FOCUS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="Today" Margin="0,22,0,4" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="TodayStats" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="This week" Margin="0,20,0,4" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="WeekStats" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="All time" Margin="0,20,0,4" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="AllTimeStats" FontSize="18" FontWeight="SemiBold"/>
                    <Border Height="1" Background="#3A3F4C" Margin="0,26"/>
                    <Button Content="Choose alarm sound" HorizontalAlignment="Left" Click="ChooseAlarm_Click"/>
                    <TextBlock x:Name="AlarmName" Text="Default system chime" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

