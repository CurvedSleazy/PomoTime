{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run PomoTime (Hot Reload)",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Microsoft\\dotnet\\dotnet.exe",
      "args": ["watch", "run", "--project", "${workspaceFolder}/PomoTime.csproj"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "build test exe",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build-exe.ps1"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    }
  ]
}
